NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://maxshop:CHANGE_ME@localhost:5432/maxshop
# Generate independently: openssl rand -base64 48
SESSION_PEPPER=REPLACE_WITH_48_RANDOM_BYTES
TOKEN_PEPPER=REPLACE_WITH_DIFFERENT_48_RANDOM_BYTES
PUBLIC_ORIGIN=https://your-domain.example
COOKIE_SECURE=true
# Set only when behind a known trusted reverse proxy; use the correct hop count.
TRUST_PROXY=1
